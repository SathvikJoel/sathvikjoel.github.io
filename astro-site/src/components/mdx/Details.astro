---
interface Props {
  title: string
}
const { title } = Astro.props
---
<details
  class="group my-4 rounded-lg border border-ink-light/15 px-4 py-2 dark:border-ink-dark/15"
>
  <summary class="cursor-pointer list-none font-sans font-medium marker:hidden">
    <span class="mr-1 inline-block transition-transform group-open:rotate-90">›</span>
    {title}
  </summary>
  <div class="mt-2">
    <slot />
  </div>
</details>
