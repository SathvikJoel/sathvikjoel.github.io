---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@lib/utils"

type Props = {
  entry: CollectionEntry<"posts">
  showTopic?: boolean
}

const { entry, showTopic = false } = Astro.props
const { title, description, date, topic, tags, kind, growthStage } = entry.data
const href = `/posts/${entry.slug}`
const isNote = kind === "note"
const stageEmoji = { seedling: "🌱", budding: "🌿", evergreen: "🌳" }
---

<a
  href={href}
  class:list={[
    "group relative block h-full p-5 rounded-2xl border transition-all duration-300 ease-out",
    "border-black/10 dark:border-white/15 hover:border-black/25 dark:hover:border-white/30",
    "bg-surface-light/40 dark:bg-surface-dark/40 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/5",
  ]}
>
  <span
    class:list={[
      "absolute left-0 top-5 bottom-5 w-[3px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300",
      isNote ? "bg-clay" : "bg-sage",
    ]}
  ></span>

  <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-wide opacity-70">
    {showTopic && (
      <span class="capitalize font-medium text-sage dark:text-sage-dark">{topic}</span>
    )}
    {showTopic && <span class="opacity-40">·</span>}
    <span class="font-mono">{formatDate(date)}</span>
    <span class="opacity-40">·</span>
    <span>{readingTime(entry.body)}</span>
    {isNote && growthStage && (
      <span class="ml-auto text-sm normal-case" title={growthStage}>{stageEmoji[growthStage]}</span>
    )}
  </div>

  <h3
    class:list={[
      "font-display font-semibold leading-tight mt-2 text-black dark:text-white",
      "text-2xl group-hover:text-sage dark:group-hover:text-sage-dark transition-colors duration-300",
      isNote && "italic",
    ]}
  >
    {title}
  </h3>

  {description && (
    <p class="font-serif text-lg leading-snug opacity-80 mt-1 line-clamp-2">{description}</p>
  )}

  {tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5 mt-3">
      {tags.slice(0, 4).map((tag) => (
        <li class="text-[0.7rem] uppercase tracking-wide py-0.5 px-2 rounded-full bg-black/5 dark:bg-white/10 opacity-75">
          {tag}
        </li>
      ))}
    </ul>
  )}
</a>
