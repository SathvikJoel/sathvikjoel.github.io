---
// Maggie-style table of contents: fixed in the left margin on wide screens,
// hidden on narrower viewports where there is no gutter room.
interface Heading {
  depth: number
  slug: string
  text: string
}
interface Props {
  headings: Heading[]
}
const { headings } = Astro.props
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
const show = items.length >= 2
---

{show && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc-label">Contents</p>
    <ul class="toc-list">
      {items.map((h) => (
        <li class:list={["toc-item", h.depth === 3 && "toc-sub"]}>
          <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    display: none;
  }
  /* Only show once there's gutter room beside the centred md column. */
  @media (min-width: 1280px) {
    .toc {
      display: block;
      position: fixed;
      top: 7.5rem;
      left: calc((100vw - 48rem) / 2 - 13.5rem);
      width: 12rem;
      max-height: 72vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-right: 0.5rem;
    }
  }
  @media (min-width: 1536px) {
    .toc {
      left: calc((100vw - 48rem) / 2 - 15rem);
      width: 13rem;
    }
  }
  .toc-label {
    @apply font-sans text-[0.68rem] uppercase tracking-[0.15em] text-ink-light/45 dark:text-ink-dark/45 mb-3;
  }
  .toc-list {
    @apply flex flex-col gap-2 m-0 p-0 list-none border-l border-clay/15 dark:border-white/10;
  }
  .toc-item {
    @apply m-0;
  }
  .toc-item a {
    @apply block font-sans text-[0.82rem] leading-snug no-underline text-ink-light/55 dark:text-ink-dark/55 pl-4 -ml-px border-l border-transparent transition-colors duration-200;
  }
  .toc-sub a {
    @apply pl-7 text-[0.78rem];
  }
  .toc-item a:hover {
    @apply text-ink-light dark:text-ink-dark;
  }
  .toc-item a.is-active {
    @apply text-crimson dark:text-crimson-dark border-crimson dark:border-crimson-dark;
  }
</style>

<script>
  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"))
    if (!links.length) return
    const bySlug = new Map(links.map((l) => [l.dataset.tocLink, l]))
    const headings = links
      .map((l) => document.getElementById(l.dataset.tocLink ?? ""))
      .filter((el): el is HTMLElement => !!el)

    let active: HTMLAnchorElement | null = null
    const setActive = (slug: string | undefined) => {
      if (!slug) return
      const next = bySlug.get(slug) ?? null
      if (next === active) return
      active?.classList.remove("is-active")
      next?.classList.add("is-active")
      active = next
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (visible[0]) setActive(visible[0].target.id)
      },
      { rootMargin: "-10% 0px -70% 0px", threshold: 0 }
    )
    headings.forEach((h) => observer.observe(h))
  }

  initToc()
  document.addEventListener("astro:after-swap", initToc)
</script>
