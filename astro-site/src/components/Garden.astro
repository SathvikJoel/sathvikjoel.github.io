---
import type { CollectionEntry } from "astro:content"
import PostCard from "@components/PostCard.astro"
import { TOPICS } from "@consts"

type Props = {
  posts: CollectionEntry<"posts">[]
  showFilters?: boolean
}

const { posts, showFilters = true } = Astro.props

const count = (pred: (p: CollectionEntry<"posts">) => boolean) => posts.filter(pred).length

const topicFacets = TOPICS.map((t) => ({
  value: t.KEY,
  label: t.LABEL,
  n: count((p) => p.data.topic === t.KEY),
}))

const kindFacets = [
  { value: "essay", label: "Essays", n: count((p) => p.data.kind === "essay") },
  { value: "note", label: "Notes", n: count((p) => p.data.kind === "note") },
  { value: "micro", label: "Micro", n: count((p) => p.data.kind === "micro") },
]

const stageFacets = [
  { value: "seedling", label: "Seedling", n: count((p) => p.data.growthStage === "seedling") },
  { value: "budding", label: "Budding", n: count((p) => p.data.growthStage === "budding") },
  { value: "evergreen", label: "Evergreen", n: count((p) => p.data.growthStage === "evergreen") },
]

const groups = [
  { name: "kind", placeholder: "All types", facets: kindFacets },
  { name: "topic", placeholder: "All streams", facets: topicFacets },
  { name: "stage", placeholder: "All stages", facets: stageFacets },
]
---

{showFilters && (
  <div class="filter-bar animate flex flex-wrap items-center gap-2 mb-8">
    {groups.map((g) => (
      <div class="facet-dd relative" data-group={g.name} data-placeholder={g.placeholder}>
        <button type="button" class="facet-toggle" aria-haspopup="true" aria-expanded="false">
          <span class="facet-label">{g.placeholder}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="facet-chevron size-3.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="facet-menu" hidden>
          {g.facets.map((f) => (
            <label class:list={["facet-option", f.n === 0 && "is-empty"]}>
              <input type="checkbox" value={f.value} disabled={f.n === 0} />
              <span class="facet-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="facet-text">{f.label}</span>
              <span class="facet-n">{f.n}</span>
            </label>
          ))}
        </div>
      </div>
    ))}
  </div>
)}

<div class="garden-grid columns-1 sm:columns-2 lg:columns-3 gap-4" data-garden>
  {posts.map((post) => <PostCard entry={post} />)}
</div>
<p class="garden-empty hidden font-serif text-xl italic text-ink-light/60 dark:text-ink-dark/60 mt-6" data-empty>
  Nothing matches that combination yet — try widening your filters.
</p>

<style>
  .facet-toggle {
    @apply flex items-center gap-2 font-sans text-sm pl-3 pr-2.5 py-1.5 rounded-lg border border-clay/20 dark:border-white/15 bg-surface-light dark:bg-surface-dark text-ink-light/80 dark:text-ink-dark/80 transition-colors duration-200 cursor-pointer;
  }
  .facet-toggle:hover {
    @apply border-clay/50 text-ink-light dark:text-ink-dark;
  }
  .facet-dd.is-active .facet-toggle {
    @apply border-crimson/60 text-ink-light dark:text-ink-dark;
  }
  .facet-dd.has-selection .facet-toggle {
    @apply border-crimson/60 text-crimson dark:text-crimson-dark;
  }
  .facet-chevron {
    @apply opacity-60 transition-transform duration-200;
  }
  .facet-dd.is-open .facet-chevron {
    @apply rotate-180;
  }
  .facet-menu {
    @apply absolute left-0 top-[calc(100%+0.4rem)] z-30 min-w-[12rem] p-1.5 rounded-xl border border-clay/20 dark:border-white/15 bg-surface-light dark:bg-surface-dark shadow-lg;
  }
  .facet-menu[hidden] { display: none; }
  .facet-option {
    @apply flex items-center gap-2.5 px-2 py-1.5 rounded-lg font-sans text-sm text-ink-light/85 dark:text-ink-dark/85 cursor-pointer transition-colors duration-150;
  }
  .facet-option:hover {
    @apply bg-black/5 dark:bg-white/10;
  }
  .facet-option.is-empty {
    @apply opacity-35 cursor-not-allowed;
  }
  .facet-option input {
    @apply sr-only;
  }
  .facet-check {
    @apply flex items-center justify-center size-4 rounded border border-clay/40 dark:border-white/30 text-white shrink-0 transition-colors duration-150;
  }
  .facet-check svg { @apply size-3 opacity-0 transition-opacity duration-150; }
  .facet-option input:checked ~ .facet-check {
    @apply bg-crimson dark:bg-crimson-dark border-transparent;
  }
  .facet-option input:checked ~ .facet-check svg { @apply opacity-100; }
  .facet-text { @apply flex-1; }
  .facet-n { @apply text-[0.7em] opacity-50 tabular-nums; }
  .post-card.filtered-out {
    display: none;
  }
</style>

<script>
  function initGarden() {
    const grid = document.querySelector<HTMLElement>("[data-garden]")
    if (!grid) return
    const empty = document.querySelector<HTMLElement>("[data-empty]")
    const state: Record<string, Set<string>> = { kind: new Set(), topic: new Set(), stage: new Set() }

    function apply() {
      const cards = grid!.querySelectorAll<HTMLElement>("[data-card]")
      let visible = 0
      cards.forEach((card) => {
        const ok =
          (state.kind.size === 0 || state.kind.has(card.dataset.kind ?? "")) &&
          (state.topic.size === 0 || state.topic.has(card.dataset.topic ?? "")) &&
          (state.stage.size === 0 || state.stage.has(card.dataset.stage ?? ""))
        card.classList.toggle("filtered-out", !ok)
        if (ok) visible++
      })
      if (empty) empty.classList.toggle("hidden", visible !== 0)
    }

    const dds = Array.from(document.querySelectorAll<HTMLElement>(".filter-bar .facet-dd"))

    function closeAll(except?: HTMLElement) {
      dds.forEach((dd) => {
        if (dd === except) return
        dd.classList.remove("is-open")
        dd.querySelector(".facet-menu")?.setAttribute("hidden", "")
        dd.querySelector(".facet-toggle")?.setAttribute("aria-expanded", "false")
      })
    }

    dds.forEach((dd) => {
      const name = dd.dataset.group!
      const placeholder = dd.dataset.placeholder ?? "All"
      const toggle = dd.querySelector<HTMLButtonElement>(".facet-toggle")!
      const menu = dd.querySelector<HTMLElement>(".facet-menu")!
      const labelEl = dd.querySelector<HTMLElement>(".facet-label")!

      toggle.addEventListener("click", (e) => {
        e.stopPropagation()
        const willOpen = !dd.classList.contains("is-open")
        closeAll(dd)
        dd.classList.toggle("is-open", willOpen)
        toggle.setAttribute("aria-expanded", String(willOpen))
        if (willOpen) menu.removeAttribute("hidden")
        else menu.setAttribute("hidden", "")
      })

      menu.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((cb) => {
        cb.addEventListener("change", () => {
          if (cb.checked) state[name].add(cb.value)
          else state[name].delete(cb.value)

          const selected = menu.querySelectorAll<HTMLInputElement>("input:checked")
          if (selected.length === 0) labelEl.textContent = placeholder
          else if (selected.length === 1) {
            labelEl.textContent = selected[0].parentElement!.querySelector(".facet-text")!.textContent
          } else labelEl.textContent = `${selected.length} selected`

          dd.classList.toggle("has-selection", selected.length > 0)
          apply()
        })
      })
    })

    document.addEventListener("click", () => closeAll())
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAll() })
  }

  initGarden()
  document.addEventListener("astro:after-swap", initGarden)
</script>
