---
import type { CollectionEntry } from "astro:content"

type Props = {
  posts: CollectionEntry<"posts">[]
}

const { posts } = Astro.props

// Steph Ango-style stamp: "2025 · 07" (year · zero-padded month).
const stamp = (date: Date) =>
  `${date.getFullYear()} · ${String(date.getMonth() + 1).padStart(2, "0")}`
---

<ul class="writing-list animate">
  {posts.map((post) => (
    <li>
      <a href={`/posts/${post.slug}`} class="writing-row">
        <time class="writing-date" datetime={post.data.date.toISOString()}>
          {stamp(post.data.date)}
        </time>
        <span class="writing-title">{post.data.title}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .writing-list {
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 2;
  }

  .writing-row {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    text-decoration: none;
  }

  .writing-date {
    @apply font-sans text-ink-light/45 dark:text-ink-dark/45;
    flex-shrink: 0;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .writing-title {
    @apply font-serif text-ink-light/90 dark:text-ink-dark/90;
    font-size: 1.18rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .writing-row:hover .writing-title {
    @apply text-crimson dark:text-crimson-dark;
    text-decoration-color: currentColor;
  }

  .writing-row:hover .writing-date {
    @apply text-ink-light/70 dark:text-ink-dark/70;
  }
</style>
