---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { formatDate, readingTime } from "@lib/utils"
import Figure from "@components/mdx/Figure.astro"
import Excursion from "@components/mdx/Excursion.astro"
import Details from "@components/mdx/Details.astro"
import CodeCaption from "@components/mdx/CodeCaption.astro"
import InlineSVG from "@components/mdx/InlineSVG.astro"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return posts.map((post) => {
    const [topic, slug] = post.slug.split("/")
    return { params: { topic, slug }, props: post }
  })
}

type Props = CollectionEntry<"posts">
const post = Astro.props
const { title, description, date, topic, kind, growthStage, lastTended } = post.data
const { Content } = await post.render()

// Prev / next within the same topic, by date.
const siblings = (await getCollection("posts"))
  .filter((p) => p.data.topic === topic && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = siblings.findIndex((p) => p.slug === post.slug)
const prev = index > 0 ? siblings[index - 1] : null
const next = index < siblings.length - 1 ? siblings[index + 1] : null

const mdxComponents = { Figure, Excursion, Details, CodeCaption, InlineSVG }
const stageLabel = { seedling: "🌱 Seedling", budding: "🌿 Budding", evergreen: "🌳 Evergreen" }
const isNote = kind === "note"
---

<PageLayout title={title} description={description}>
  <TopLayout>
    <div class="animate">
      <a href={`/posts/${topic}`} class="group w-fit p-1.5 gap-1.5 text-sm flex items-center border rounded hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white">
          <line x1="19" y1="12" x2="5" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
          <polyline points="12 19 5 12 12 5" class="translate-x-1 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
        </svg>
        <div class="w-full capitalize group-hover:text-black group-hover:dark:text-white transition-colors duration-300 ease-in-out">
          Back to {topic}
        </div>
      </a>
      <div class="flex flex-wrap items-center text-sm uppercase mt-12 gap-3 opacity-75">
        <div class="flex items-center gap-2">
          <svg class="size-5 stroke-current"><use href="/ui.svg#calendar"/></svg>
          {formatDate(date)}
        </div>
        <div class="flex items-center gap-2">
          <svg class="size-5 stroke-current"><use href="/ui.svg#book-open"/></svg>
          {readingTime(post.body)}
        </div>
        {isNote && growthStage &&
          <div class="px-2 py-0.5 rounded-full bg-clay/15 text-clay normal-case tracking-wide">
            {stageLabel[growthStage]}
          </div>
        }
      </div>
      <h1 class:list={["font-display text-4xl sm:text-5xl font-semibold text-black dark:text-white mt-2 leading-tight", isNote && "italic"]}>
        {title}
      </h1>
      {description &&
        <p class="font-display italic text-xl opacity-80 mt-3">{description}</p>
      }
      {isNote && lastTended &&
        <p class="font-mono text-xs opacity-60 mt-2">last tended {formatDate(lastTended)}</p>
      }
    </div>
  </TopLayout>
  <BottomLayout>
    <article class:list={["animate prose-post", isNote && "note"]}>
      <Content components={mdxComponents}/>
    </article>

    <nav class="animate grid grid-cols-1 sm:grid-cols-2 gap-4 mt-16">
      {prev &&
        <a href={`/posts/${prev.slug}`} class="group p-4 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 hover:dark:bg-white/10 blend">
          <div class="text-xs uppercase opacity-60">Newer</div>
          <div class="font-display text-lg font-semibold mt-1 text-black dark:text-white">{prev.data.title}</div>
        </a>
      }
      {next &&
        <a href={`/posts/${next.slug}`} class="group p-4 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 hover:dark:bg-white/10 blend sm:text-right sm:col-start-2">
          <div class="text-xs uppercase opacity-60">Older</div>
          <div class="font-display text-lg font-semibold mt-1 text-black dark:text-white">{next.data.title}</div>
        </a>
      }
    </nav>
  </BottomLayout>
</PageLayout>
