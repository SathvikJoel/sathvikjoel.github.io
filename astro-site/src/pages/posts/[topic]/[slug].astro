---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { formatDate, readingTime } from "@lib/utils"
import Connections from "@components/Connections.astro"
import Figure from "@components/mdx/Figure.astro"
import Excursion from "@components/mdx/Excursion.astro"
import Details from "@components/mdx/Details.astro"
import CodeCaption from "@components/mdx/CodeCaption.astro"
import InlineSVG from "@components/mdx/InlineSVG.astro"
import Sidenote from "@components/mdx/Sidenote.astro"
import Gallery from "@components/mdx/Gallery.astro"
import MediaList from "@components/mdx/MediaList.astro"
import MediaItem from "@components/mdx/MediaItem.astro"
import Year from "@components/mdx/Year.astro"
import WideImage from "@components/mdx/WideImage.astro"
import Reference from "@components/mdx/Reference.astro"
import Pullquote from "@components/mdx/Pullquote.astro"
import ComingSoon from "@components/mdx/ComingSoon.astro"
import StageIcon from "@components/StageIcon.astro"
import TableOfContents from "@components/TableOfContents.astro"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return posts.map((post) => {
    const [topic, slug] = post.slug.split("/")
    return { params: { topic, slug }, props: post }
  })
}

type Props = CollectionEntry<"posts">
const post = Astro.props
const { title, description, date, topic, kind, growthStage, lastTended, tags } = post.data
const { Content, headings } = await post.render()

// All posts (used by Connections for backlinks).
const allPosts = await getCollection("posts")

const mdxComponents = { Figure, Excursion, Details, CodeCaption, InlineSVG, Sidenote, Gallery, MediaList, MediaItem, Year, Y: Year, WideImage, Reference, Callout: Reference, Pullquote, ComingSoon }
const stageWord = { seedling: "Seedling", budding: "Budding", evergreen: "Evergreen" }
const isNote = kind === "note"
const isMicro = kind === "micro"
---

<PageLayout title={title} description={description}>
  <TopLayout>
    <div class="animate">
      <nav class="font-sans text-sm flex flex-wrap items-center gap-2 text-ink-light/60 dark:text-ink-dark/60" aria-label="Breadcrumb">
        <a href="/" class="hover:text-crimson dark:hover:text-crimson-dark transition-colors">All writing</a>
        <span class="opacity-30">/</span>
        <a href={`/posts/${topic}`} class="capitalize hover:text-crimson dark:hover:text-crimson-dark transition-colors">{topic}</a>
      </nav>
      <div class="flex flex-wrap items-center font-sans text-sm mt-12 gap-2 text-ink-light/60 dark:text-ink-dark/60">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {!isMicro && (
          <>
            <span class="opacity-30">·</span>
            <span>{readingTime(post.body)}</span>
          </>
        )}
        {isNote && growthStage &&
          <>
            <span class="opacity-30">·</span>
            <span class="group inline-flex items-center gap-1.5 text-clay dark:text-clay-dark">
              <StageIcon stage={growthStage} class="size-4" />
              {stageWord[growthStage]}
            </span>
          </>
        }
      </div>
      <h1 class:list={["font-display text-4xl sm:text-5xl font-light text-black dark:text-white mt-2 leading-tight", isNote && "italic"]}>
        {title}
      </h1>
      {description &&
        <p class="font-display italic text-xl opacity-80 mt-3">{description}</p>
      }
      {isNote && lastTended &&
        <p class="font-mono text-xs opacity-60 mt-2">last tended {formatDate(lastTended)}</p>
      }
    </div>
  </TopLayout>
  <BottomLayout>
    <TableOfContents headings={headings} />
    <article class:list={["animate prose-post", isNote && "note"]}>
      <Content components={mdxComponents}/>
    </article>

    {tags.length > 0 && (
      <div class="animate mt-10 pt-6 border-t border-black/10 dark:border-white/10">
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="font-sans text-xs uppercase tracking-wide py-1 px-3 rounded-full border border-clay/20 dark:border-white/15 text-ink-light/65 dark:text-ink-dark/65 hover:border-crimson/50 hover:text-crimson dark:hover:text-crimson-dark transition-colors">
              #{tag}
            </li>
          ))}
        </ul>
      </div>
    )}

    <Connections post={post} all={allPosts} />
  </BottomLayout>
</PageLayout>
