---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Garden from "@components/Garden.astro"
import { TOPICS } from "@consts"

export async function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { topic: t.KEY }, props: { topic: t } }))
}

const { topic } = Astro.props
const posts = (await getCollection("posts"))
  .filter((p) => p.data.topic === topic.KEY && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<PageLayout title={`${topic.LABEL} — Writing`} description={topic.BLURB}>
  <div class="mx-auto max-w-[1420px] px-5 sm:px-8 pt-28 pb-24">
    <header class="animate max-w-2xl mb-10">
      <a href="/posts" class="font-sans text-sm text-ink-light/60 dark:text-ink-dark/60 hover:text-crimson dark:hover:text-crimson-dark transition-colors">← All writing</a>
      <div class="flex items-center gap-3 mt-4">
        <span class="text-4xl">{topic.EMOJI}</span>
        <h1 class="font-display text-4xl sm:text-5xl font-light text-ink-light dark:text-ink-dark">{topic.LABEL}</h1>
      </div>
      <p class="font-serif text-xl text-ink-light/70 dark:text-ink-dark/70 mt-3">{topic.BLURB}</p>
      <p class="font-sans text-xs uppercase tracking-wide text-ink-light/45 dark:text-ink-dark/45 mt-3">{posts.length} {posts.length === 1 ? "piece" : "pieces"}</p>
    </header>
    <Garden posts={posts} showFilters={false} />
  </div>
</PageLayout>
