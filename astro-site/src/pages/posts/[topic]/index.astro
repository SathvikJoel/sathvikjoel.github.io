---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Garden from "@components/Garden.astro"
import StreamFeed from "@components/StreamFeed.astro"
import { TOPICS } from "@consts"

export async function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { topic: t.KEY }, props: { topic: t } }))
}

const { topic } = Astro.props
const posts = (await getCollection("posts"))
  .filter((p) => p.data.topic === topic.KEY && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const isFeed = topic.LAYOUT === "feed"
const wrap = isFeed ? "max-w-2xl" : "max-w-[1420px]"
---

<PageLayout title={`${topic.LABEL} — Writing`} description={topic.BLURB}>
  <div class:list={["mx-auto px-5 sm:px-8 pt-28 pb-24", wrap]}>
    <header class="animate mb-12">
      <a href="/" class="font-sans text-sm text-ink-light/60 dark:text-ink-dark/60 hover:text-crimson dark:hover:text-crimson-dark transition-colors">← All writing</a>
      <h1 class="font-display text-4xl sm:text-5xl font-light text-ink-light dark:text-ink-dark mt-4">
        <span class="count-badge" title={`${posts.length} posts`}>{posts.length}</span>{topic.LABEL}
      </h1>
      <p class="font-serif text-xl sm:text-2xl italic text-ink-light/75 dark:text-ink-dark/75 mt-4 max-w-2xl leading-relaxed">{topic.BLURB}</p>
    </header>

    {isFeed ? <StreamFeed posts={posts} /> : <Garden posts={posts} showFilters={false} />}
  </div>
</PageLayout>

<style>
  .count-badge {
    @apply font-sans text-sm sm:text-base font-semibold text-crimson dark:text-crimson-dark;
    vertical-align: super;
    margin-right: 0.3em;
    line-height: 1;
  }
</style>
