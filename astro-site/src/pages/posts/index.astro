---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Garden from "@components/Garden.astro"
import { POSTS } from "@consts"

const all = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<PageLayout title={POSTS.TITLE} description={POSTS.DESCRIPTION}>
  <div class="mx-auto max-w-[1420px] px-5 sm:px-8 pt-28 pb-24">
    <header class="animate max-w-2xl mb-10">
      <h1 class="font-display text-4xl sm:text-5xl font-light text-ink-light dark:text-ink-dark">{POSTS.TITLE}</h1>
      <p class="font-serif text-xl text-ink-light/70 dark:text-ink-dark/70 mt-3">{POSTS.DESCRIPTION}</p>
    </header>
    <Garden posts={all} />
  </div>
</PageLayout>
