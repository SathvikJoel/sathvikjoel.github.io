---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { ABOUT, SOCIALS } from "@consts"
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <TopLayout>
    <div class="animate flex flex-col-reverse sm:flex-row sm:items-end gap-6">
      <div class="flex-1">
        <h1 class="font-display text-4xl sm:text-5xl font-semibold text-black dark:text-white">Hi, I'm Sathvik.</h1>
        <p class="font-serif text-xl opacity-80 mt-2">Re-deriving things by hand, and trying to pay attention.</p>
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate prose-post">
      <p>
        I write here mostly to find out what I think. An idea never quite feels like mine until
        I've turned it over in words — re-derived the awkward step by hand, or followed some small
        question well past the point of usefulness. This is where that happens.
      </p>
      <p>
        I'm drawn to things that stay honest under pressure: a proof that finally closes, a myth
        that refuses a tidy ending, the slow work of paying attention. If something here stays with
        you — or you just want to say hello — I'd genuinely like that.
      </p>

      <h2>Find me</h2>
      <ul>
        {SOCIALS.map((social) => (
          <li><a href={social.HREF} target="_blank">{social.NAME}</a> — {social.TEXT}</li>
        ))}
      </ul>

      <p>
        <a href="/resume">Read my resume →</a>
      </p>
    </article>
  </BottomLayout>
</PageLayout>
