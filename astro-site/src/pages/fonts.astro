---
// TEMPORARY body-font comparison page. Delete after a choice is made.
// Headings stay Fraunces (already liked); each block swaps only the BODY font.
import "@fontsource-variable/fraunces"
import "@fontsource-variable/fraunces/wght-italic.css"
const samples = [
  { name: "Fraunces — text cut (your ACTUAL current body)", css: "'Fraunces Variable', serif", weight: 300, note: "Exactly what's on your blog now: the soft, wide TEXT master, self-hosted. Your CSS opsz pin is a no-op (this file has no opsz axis)." },
  { name: "Fraunces — display cut (opsz 100, spiky)", css: "'Fraunces', serif", weight: 300, vs: '"opsz" 100', note: "Fraunces' high-contrast DISPLAY master. Spikier, narrower. (This is what the preview wrongly showed before.)" },
  { name: "Syne — weight 400", css: "'Syne', sans-serif", weight: 400, note: "Quirky geometric sans display face (Bonjour Monde). Distinctive and contemporary, but designed for headlines — watch readability over long paragraphs." },
  { name: "Cormorant — weight 400", css: "'Cormorant', serif", weight: 400, note: "Elegant high-contrast Garamond display face. Beautiful, literary — but strokes thin out at body sizes, so test legibility on mobile." },
  { name: "Cormorant — weight 500 (a touch sturdier)", css: "'Cormorant', serif", weight: 500, note: "Same face, slightly heavier so thin strokes hold up better against the black background." },
  { name: "Cormorant Garamond — weight 400", css: "'Cormorant Garamond', serif", weight: 400, note: "The Garamond-tuned sibling: a hair more even in weight, often easier as running text than plain Cormorant." },
  { name: "Newsreader", css: "'Newsreader', serif", weight: 400, note: "Designed for on-screen news reading. Warm, NYT-ish, easy on the eyes." },
  { name: "Source Serif 4", css: "'Source Serif 4', serif", weight: 400, note: "Clean, neutral, modern. Very legible, slightly cooler tone." },
  { name: "Spectral", css: "'Spectral', serif", weight: 300, note: "Calm, low-contrast, made by Production Type for Google Docs." },
  { name: "Literata", css: "'Literata', serif", weight: 400, note: "Google Play Books reading face. Bookish, sturdy, excellent for essays." },
  { name: "Lora", css: "'Lora', serif", weight: 400, note: "Warm calligraphic roots, brushed contrast. Friendly and readable." },
  { name: "PT Serif", css: "'PT Serif', serif", weight: 400, note: "Transitional, Times-adjacent but warmer. Workhorse body face." },
  { name: "Bitter", css: "'Bitter', serif", weight: 400, note: "Slab serif tuned for screens. Even color, very steady reading rhythm." },
]
const para1 = "We shape our tools, and thereafter our tools shape us. A page is a tool for thinking, and the typeface is the grain of the wood — you feel it under the hand long before you can name it."
const para2 = "Good body text disappears. It carries the argument across a long evening of reading without ever asking to be admired; the moment you notice the letters, something has gone slightly wrong."
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Body font comparison</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&family=Cormorant:ital,wght@0,300..700;1,300..700&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..600;1,8..60,300..600&family=Spectral:ital,wght@0,300;0,400;1,300;1,400&family=Literata:ital,opsz,wght@0,7..72,300..600;1,7..72,300..600&family=Lora:ital,wght@0,400..600;1,400..600&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Bitter:ital,wght@0,300..600;1,300..600&display=swap"
/>
<style>
  :root { color-scheme: dark; }
  html { font-size: 18px; }
  body {
    margin: 0;
    background: #000;
    color: #ECEAE6;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 44rem; margin: 0 auto; padding: 4rem 1.5rem 8rem; }
  .lead { font-family: 'Fraunces', serif; font-weight: 300; font-size: 1rem; opacity: .6; letter-spacing: .02em; text-transform: uppercase; }
  h1.title { font-family: 'Fraunces', serif; font-weight: 300; font-size: 2.6rem; line-height: 1.1; margin: .3rem 0 3rem; }
  .sample { padding: 2.5rem 0; border-top: 1px solid rgba(255,255,255,.12); }
  .label { font-family: 'Fraunces', serif; font-weight: 400; font-size: 1.05rem; color: #FF6FB5; }
  .note { font-family: ui-sans-serif, system-ui, sans-serif; font-size: .8rem; opacity: .55; margin: .35rem 0 1.4rem; max-width: 36rem; }
  .sample h2 { font-family: 'Fraunces', serif; font-weight: 300; font-size: 1.9rem; line-height: 1.15; margin: 0 0 1rem; color: #fff; }
  .body p {
    font-size: 1.2rem;
    line-height: 1.78;
    margin: 0 0 1rem;
  }
  .body strong { font-weight: 600; }
</style>
</head>
<body>
  <div class="wrap">
    <p class="lead">Body font comparison · headings stay Fraunces</p>
    <h1 class="title">The grain of the page</h1>

    {samples.map((s) => (
      <section class="sample">
        <div class="label">{s.name}</div>
        <p class="note">{s.note}</p>
        <h2>An editorial heading set in Fraunces</h2>
        <div class="body" style={`font-family:${s.css};font-weight:${s.weight};${s.vs ? `font-variation-settings:${s.vs};` : ""}`}>
          <p>{para1.split(" tools shape us")[0]} <strong>tools shape us</strong>{para1.split("tools shape us")[1]}</p>
          <p style={`font-style:italic`}>{para2}</p>
        </div>
      </section>
    ))}
  </div>
</body>
</html>
