---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Garden from "@components/Garden.astro"
import { SITE } from "@consts"

const all = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <div class="mx-auto max-w-[1420px] px-5 sm:px-8 pt-28 pb-24">
    <!-- Compact header -->
    <header class="animate max-w-2xl mx-auto text-center mb-12">
      <p class="font-sans text-sm uppercase tracking-[0.2em] text-sage dark:text-sage-dark">The garden of Sathvik Joel</p>
      <h1 class="font-display text-4xl sm:text-5xl font-light leading-[1.1] text-ink-light dark:text-ink-dark mt-3">
        <span class="count-badge" title={`${all.length} posts`}>{all.length}</span>Essays &amp; field notes, growing over time.
      </h1>
      <p class="font-serif text-xl leading-snug text-ink-light/70 dark:text-ink-dark/70 mt-4">
        I document what I'm learning across <span class="text-sage dark:text-sage-dark">tech</span>,
        <span class="text-clay">life</span>, and philosophy — some pieces polished, some still sprouting.
        Filter by type, topic, or how mature a piece is.
      </p>
    </header>

    <Garden posts={all} />
  </div>
</PageLayout>

<style>
  .count-badge {
    @apply font-sans text-sm sm:text-base font-semibold text-crimson dark:text-crimson-dark;
    vertical-align: super;
    margin-right: 0.3em;
    line-height: 1;
  }
</style>
