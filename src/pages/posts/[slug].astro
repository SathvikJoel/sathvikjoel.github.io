---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { relativeDate, readingTime } from "@lib/utils"
import Connections from "@components/Connections.astro"
import { mdxComponents } from "@components/mdx/registry"
import StageIcon from "@components/StageIcon.astro"
import TableOfContents from "@components/TableOfContents.astro"
import { TOPICS } from "@consts"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  const topics = new Set<string>(TOPICS.map((t) => t.KEY))
  return posts.map((post) => {
    // Posts live flat at src/content/posts/<slug>/index.md(x), so the content slug
    // is a single segment and the post is served at /posts/<slug>. The stream a post
    // belongs to is decided by its `topic` frontmatter alone, not its folder location.
    const slug = post.slug
    if (slug.includes("/")) {
      throw new Error(
        `Post "${post.slug}" must live exactly one folder deep at ` +
          `posts/<slug>/index.md(x). Nested post folders are no longer supported.`
      )
    }
    // The flat post URL /posts/<slug> shares the /posts/ namespace with the stream
    // index pages /posts/<topic>. A post folder named like a stream would silently
    // overwrite that listing, so fail the build loudly instead.
    if (topics.has(slug)) {
      throw new Error(
        `Post folder "${slug}" collides with the "/posts/${slug}" stream URL. ` +
          `Rename the post folder so flat post URLs stay unambiguous.`
      )
    }
    return { params: { slug }, props: post }
  })
}

type Props = CollectionEntry<"posts">
const post = Astro.props
const { title, description, date, topic, growthStage, stageIcon, lastTended, tags, width, dropCap, topGlow, coverAlt, imageAlt, ogImageAlt, draft, unlisted } = post.data
const { Content, headings } = await post.render()

// All posts (used by Connections for backlinks). Unlisted posts are excluded so
// they don't surface as related/backlinks, but their own page still builds.
const allPosts = (await getCollection("posts")).filter((p) => !p.data.unlisted)

const breadcrumbStage = growthStage

// Per-post Open Graph card: scripts/build-og.mjs generates /og/<slug>.jpg (1200×630)
// for EVERY post — an explicit ogImage, else cover/image art, else an auto title card.
// So every post page gets its own branded share image at /og/<slug>.jpg.
const ogImage = `/og/${post.slug}.jpg`
const ogAlt = ogImageAlt || coverAlt || imageAlt || `${title} — JoeLogs`
---

<PageLayout title={title} description={description} topGradient={topGlow} image={ogImage} imageAlt={ogAlt} noindex={draft || unlisted} type="article" publishedTime={date.toISOString()} modifiedTime={lastTended ? lastTended.toISOString() : undefined} keywords={tags}>
  <TopLayout>
    <div class:list={["animate", width === "wide" && "wide-col"]}>
      <a href={`/posts/${topic}`} class="breadcrumb-stream group" aria-label={`Back to the ${topic} stream`}>
        <svg class="bc-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="M16 10H4m5-5l-5 5 5 5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="bc-stream">{topic}</span>
        <StageIcon stage={breadcrumbStage} src={stageIcon} class="size-4 mx-2" />
        <span class="bc-stage">{growthStage}</span>
      </a>
      <h1 class="font-display text-4xl sm:text-5xl font-light text-black dark:text-white mt-6 leading-tight">
        {title}
      </h1>
      {description &&
        <p class="font-display font-light text-lg sm:text-xl opacity-70 mt-3">{description}</p>
      }
      <hr class="border-t mt-6 border-crimson/50 dark:border-crimson-dark/50" />
      <div class="flex flex-col items-end font-sans text-sm mt-3 text-ink-light/55 dark:text-ink-dark/55">
        <time datetime={date.toISOString()}>{relativeDate(date)}</time>
        <span>{readingTime(post.body)}</span>
      </div>
      {lastTended &&
        <p class="font-mono text-xs opacity-60 mt-2">last tended {relativeDate(lastTended)}</p>
      }
    </div>
  </TopLayout>
  <BottomLayout>
    <TableOfContents headings={headings} pinned={width !== "wide"} />
    <article class:list={["animate prose-post", width === "wide" && "wide-col", !dropCap && "no-dropcap"]}>
      <Content components={mdxComponents}/>
    </article>

    {tags.length > 0 && (
      <div class:list={["animate mt-10 pt-6 border-t border-black/10 dark:border-white/10", width === "wide" && "wide-col"]}>
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="font-sans text-xs uppercase tracking-wide py-1 px-3 rounded-full border border-clay/20 dark:border-white/15 text-ink-light/65 dark:text-ink-dark/65 hover:border-crimson/50 hover:text-crimson dark:hover:text-crimson-dark transition-colors">
              #{tag}
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class:list={[width === "wide" && "wide-col"]}>
      <Connections post={post} all={allPosts} />
    </div>
  </BottomLayout>
</PageLayout>

<style>
  .breadcrumb-stream {
    @apply inline-flex items-center no-underline;
  }
  .bc-stream {
    @apply font-sans text-crimson dark:text-crimson-dark;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .bc-stage {
    @apply font-sans text-black dark:text-white;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 400;
  }
  .bc-arrow {
    width: 0;
    height: 0.85em;
    opacity: 0;
    color: #3dd6ed;
    transform: translateX(4px);
    transition: width 0.25s ease, opacity 0.25s ease, transform 0.25s ease,
      margin-right 0.25s ease;
  }
  .breadcrumb-stream:hover .bc-arrow {
    width: 0.85em;
    opacity: 1;
    transform: translateX(0);
    margin-right: 0.4em;
  }
</style>
