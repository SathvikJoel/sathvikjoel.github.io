---
// A YouTube Shorts card styled like a Tufte sidenote: a small vertical (9:16) thumbnail
// with the title and source below it, floated into the right margin on wide screens and
// hugging the right edge of the column on narrow ones. The whole card links to the Short.
// Pass the Short id; the vertical thumbnail uses YouTube's `oardefault` (original aspect
// ratio) frame so there are no letterbox bars. Override with `thumb` / `href` if needed.
// Marker: like a Tufte sidenote, the card ties back to a point in the prose with a small
// crimson superscript. Pass the `ref` prop to show one: bare `ref` (or ref="play") gives
// the standard play glyph that signals "watch this short"; ref={1} (or any value) shows
// that number/symbol instead, so it can share the Sidenote's numbering family.
interface Props {
  id: string
  title: string
  source?: string
  href?: string
  thumb?: string
  ref?: string | number | boolean
}
const { id, title, source, href, thumb, ref } = Astro.props
const link = href ?? `https://www.youtube.com/shorts/${id}`
const image = thumb ?? `https://i.ytimg.com/vi/${id}/oardefault.jpg`
// Show a marker whenever `ref` is present (and not explicitly false). A bare `ref`, an
// empty string, or "play" renders the play glyph; anything else renders verbatim.
const hasMarker = ref !== undefined && ref !== null && ref !== false
const useGlyph = ref === true || ref === "" || ref === "play"
---

{
  hasMarker && (
    <sup class="short-ref">
      {useGlyph ? (
        <svg class="short-ref-glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
      ) : (
        ref
      )}
    </sup>
  )
}
<a
  class="short-card not-prose"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Watch on YouTube: ${title}`}
>
  <span class="short-thumb">
    <img src={image} alt="" loading="lazy" decoding="async" width="1080" height="1920" />
  </span>
  <span class="short-meta">
    <span class="short-title">
      {hasMarker && (
        <span class="short-num">
          {useGlyph ? "\u25B6\uFE0E" : ref}
        </span>
      )}
      {title}
    </span>
    {source && <span class="short-source">{source}</span>}
    {Astro.slots.has("default") && <span class="short-desc"><slot /></span>}
  </span>
</a>

<style>
  .short-card {
    @apply float-right my-2 ml-5 mb-4 block no-underline;
    width: 7rem;
    clear: right;
    opacity: 0.68;
    transition: opacity 0.2s ease;
  }
  .short-ref {
    @apply font-sans font-medium text-crimson dark:text-crimson-dark;
    font-size: 1em;
    line-height: 0;
    vertical-align: baseline;
    margin-left: 0.1em;
  }
  .short-num {
    @apply font-sans text-crimson dark:text-crimson-dark;
    font-size: 1em;
    margin-right: 0.28em;
  }
  .short-ref-glyph {
    @apply inline-block text-crimson dark:text-crimson-dark;
    width: 0.92em;
    height: 0.92em;
    vertical-align: -0.12em;
  }
  .short-card:hover {
    opacity: 1;
  }
  .short-thumb {
    @apply relative block aspect-[9/16] w-full overflow-hidden rounded-sm;
    background: #000;
  }
  .short-thumb img {
    @apply h-full w-full object-cover;
    padding: 0;
    margin: 0;
  }
  .short-meta {
    @apply mt-1.5 block;
  }
  .short-title {
    @apply block font-note text-ink-light/70 dark:text-ink-dark/70;
    font-size: 0.82rem;
    line-height: 1.3;
  }
  .short-source {
    @apply mt-0.5 block font-sans text-[0.72rem] text-ink-light/45 dark:text-ink-dark/40;
  }
  .short-desc {
    @apply mt-1 block font-note text-[0.78rem] leading-relaxed text-ink-light/60 dark:text-ink-dark/55;
  }
  /* Push it out into the right margin once there's gutter room, like a sidenote. */
  @media (min-width: 1280px) {
    .short-card {
      width: 8rem;
      margin-right: -9.5rem;
      margin-left: 1.25rem;
    }
  }
</style>
