---
// A YouTube Shorts card styled like a Tufte sidenote: a small vertical (9:16) thumbnail
// with the title and source below it, floated into the right margin on wide screens and
// hugging the right edge of the column on narrow ones. The whole card links to the Short.
// Pass the Short id; the vertical thumbnail uses YouTube's `oardefault` (original aspect
// ratio) frame so there are no letterbox bars. Override with `thumb` / `href` if needed.
// Pass `ref` (e.g. "*" or a number) to drop a matching superscript marker inline in the
// prose, the way a Tufte sidenote ties its margin note back to a point in the text.
interface Props {
  id: string
  title: string
  source?: string
  href?: string
  thumb?: string
  ref?: string | number
}
const { id, title, source, href, thumb, ref } = Astro.props
const link = href ?? `https://www.youtube.com/shorts/${id}`
const image = thumb ?? `https://i.ytimg.com/vi/${id}/oardefault.jpg`
---

{ref != null && <sup class="short-ref">{ref}</sup>}
<a
  class="short-card not-prose"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Watch on YouTube: ${title}`}
>
  <span class="short-thumb">
    <img src={image} alt="" loading="lazy" decoding="async" width="1080" height="1920" />
    <span class="short-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
    </span>
  </span>
  <span class="short-meta">
    <span class="short-title">{ref != null && <sup class="short-num">{ref}</sup>}{title}</span>
    {source && <span class="short-source">{source}</span>}
    {Astro.slots.has("default") && <span class="short-desc"><slot /></span>}
  </span>
</a>

<style>
  .short-card {
    @apply float-right my-2 ml-5 mb-4 block no-underline;
    width: 7rem;
    clear: right;
    opacity: 0.68;
    transition: opacity 0.2s ease;
  }
  .short-ref {
    @apply align-super text-[0.7em] font-sans font-medium text-crimson dark:text-crimson-dark;
    line-height: 0;
  }
  .short-num {
    @apply align-super text-[0.7em] font-sans font-medium text-crimson dark:text-crimson-dark;
    line-height: 0;
    margin-right: 0.15rem;
  }
  .short-card:hover {
    opacity: 1;
  }
  .short-thumb {
    @apply relative block aspect-[9/16] w-full overflow-hidden rounded-sm;
    background: #000;
  }
  .short-thumb img {
    @apply h-full w-full object-cover;
    padding: 0;
    margin: 0;
  }
  .short-play {
    @apply absolute flex items-center justify-center text-white/90;
    right: 0.3rem;
    bottom: 0.3rem;
    width: 1.15rem;
    height: 1.15rem;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.75));
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .short-card:hover .short-play {
    color: theme(colors.crimson.dark);
    transform: scale(1.12);
  }
  .short-play svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .short-meta {
    @apply mt-1.5 block;
  }
  .short-title {
    @apply block font-note text-ink-light/70 dark:text-ink-dark/70;
    font-size: 0.82rem;
    line-height: 1.3;
  }
  .short-source {
    @apply mt-0.5 block font-sans text-[0.72rem] text-ink-light/45 dark:text-ink-dark/40;
  }
  .short-desc {
    @apply mt-1 block font-note text-[0.78rem] leading-relaxed text-ink-light/60 dark:text-ink-dark/55;
  }
  /* Push it out into the right margin once there's gutter room, like a sidenote. */
  @media (min-width: 1280px) {
    .short-card {
      width: 8rem;
      margin-right: -9.5rem;
      margin-left: 1.25rem;
    }
  }
</style>
