---
import PopulationTreemap from "@components/viz/PopulationTreemap"

interface Props {
  caption?: string
  source?: string
}
const base = "/posts/essays/overpopulation/data"
const { caption, source } = Astro.props
---

<figure class="viz-figure not-prose my-10">
  <PopulationTreemap client:visible src={`${base}/top10_countries_population_2024.csv`} />
  {
    (caption || source) && (
      <figcaption class="viz-caption">
        {caption && <span>{caption}</span>}
        {source && <span class="viz-source">{source}</span>}
      </figcaption>
    )
  }
</figure>
