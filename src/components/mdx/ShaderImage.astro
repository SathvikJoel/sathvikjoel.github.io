---
interface Props {
  src: string
  alt: string
  caption?: string
  effect?: "paper" | "halftone"
}

const { src, alt, caption, effect = "paper" } = Astro.props
---

<figure class="shader-image not-prose">
  <paper-shader-image data-src={src} data-effect={effect}>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
    <div class="shader-image__mount" data-shader-mount aria-hidden="true"></div>
    <canvas class="shader-image__output" data-shader-output aria-hidden="true"></canvas>
  </paper-shader-image>
  {caption && (
    <figcaption class="mt-3 text-center font-sans text-sm leading-snug text-ink-light/60 dark:text-ink-dark/55">
      {caption}
    </figcaption>
  )}
</figure>

<script>
  import {
    HalftoneCmykTypes,
    ShaderFitOptions,
    ShaderMount,
    defaultObjectSizing,
    getShaderColorFromString,
    getShaderNoiseTexture,
    halftoneCmykFragmentShader,
    paperTextureFragmentShader,
  } from "@paper-design/shaders"

  class PaperShaderImage extends HTMLElement {
    private shader?: ShaderMount
    private initialized = false
    private initializing = false

    connectedCallback() {
      shaderImageObserver?.observe(this)
    }

    disconnectedCallback() {
      shaderImageObserver?.unobserve(this)
      this.shader?.dispose()
      this.shader = undefined
    }

    async renderShader() {
      if (this.initialized || this.initializing) return

      const src = this.dataset.src
      const effect = this.dataset.effect === "halftone" ? "halftone" : "paper"
      const mount = this.querySelector<HTMLElement>("[data-shader-mount]")
      const output = this.querySelector<HTMLCanvasElement>("[data-shader-output]")

      if (!src || !mount || !output) {
        console.error("ShaderImage is missing its source, mount, or output canvas.")
        return
      }

      this.initializing = true

      try {
        const image = new Image()
        const imageUrl = new URL(src, window.location.href)
        if (imageUrl.origin !== window.location.origin) image.crossOrigin = "anonymous"
        image.decoding = "async"
        image.src = src
        const noiseTexture = getShaderNoiseTexture()
        if (!noiseTexture) throw new Error("Could not load the shader noise image.")
        await Promise.all([image.decode(), noiseTexture.decode()])

        if (!this.isConnected) return

        const sizingUniforms = {
          u_fit: ShaderFitOptions.cover,
          u_rotation: defaultObjectSizing.rotation,
          u_scale: 1,
          u_offsetX: defaultObjectSizing.offsetX,
          u_offsetY: defaultObjectSizing.offsetY,
          u_originX: defaultObjectSizing.originX,
          u_originY: defaultObjectSizing.originY,
          u_worldWidth: defaultObjectSizing.worldWidth,
          u_worldHeight: defaultObjectSizing.worldHeight,
        }

        const uniforms = effect === "halftone"
          ? {
              u_image: image,
              u_noiseTexture: noiseTexture,
              u_colorBack: getShaderColorFromString("#fbfaf5"),
              u_colorC: getShaderColorFromString("#00b4ff"),
              u_colorM: getShaderColorFromString("#fc519f"),
              u_colorY: getShaderColorFromString("#ffd800"),
              u_colorK: getShaderColorFromString("#231f20"),
              u_size: 0.2,
              u_contrast: 1,
              u_softness: 1,
              u_grainSize: 0.5,
              u_grainMixer: 0,
              u_grainOverlay: 0,
              u_gridNoise: 0.2,
              u_floodC: 0.15,
              u_floodM: 0,
              u_floodY: 0,
              u_floodK: 0,
              u_gainC: 0.3,
              u_gainM: 0,
              u_gainY: 0.2,
              u_gainK: 0,
              u_type: HalftoneCmykTypes.ink,
              ...sizingUniforms,
            }
          : {
              u_image: image,
              u_noiseTexture: noiseTexture,
              u_colorFront: getShaderColorFromString("#9fadbc"),
              u_colorBack: getShaderColorFromString("#ffffff"),
              u_contrast: 0.3,
              u_roughness: 0.4,
              u_fiber: 0.3,
              u_fiberSize: 0.2,
              u_crumples: 0.3,
              u_crumpleSize: 0.35,
              u_folds: 0.65,
              u_foldCount: 5,
              u_fade: 0,
              u_drops: 0.2,
              u_seed: 5.8,
              ...sizingUniforms,
            }

        this.shader = new ShaderMount(
          mount,
          effect === "halftone" ? halftoneCmykFragmentShader : paperTextureFragmentShader,
          uniforms,
          { preserveDrawingBuffer: true },
          0,
          0,
          1,
          1200 * 675,
          effect === "paper" ? ["u_image"] : undefined,
        )

        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()))
        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()))

        const shaderCanvas = this.shader.canvasElement
        output.width = shaderCanvas.width
        output.height = shaderCanvas.height

        const context = output.getContext("2d")
        if (!context) throw new Error("Could not create the ShaderImage output canvas.")

        context.drawImage(shaderCanvas, 0, 0)
        const centerPixel = context.getImageData(
          Math.floor(output.width / 2),
          Math.floor(output.height / 2),
          1,
          1,
        )
        if (centerPixel.data[3] === 0) {
          throw new Error("The shader produced an empty frame.")
        }

        this.classList.add("is-ready")
        this.initialized = true
        shaderImageObserver?.unobserve(this)
      } catch (error) {
        console.error(`Failed to render ${effect} image "${src}".`, error)
      } finally {
        this.shader?.dispose()
        this.shader = undefined
        this.initializing = false
      }
    }
  }

  const shaderImageObserver = "IntersectionObserver" in window
    ? new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              void (entry.target as PaperShaderImage).renderShader()
            }
          }
        },
        { rootMargin: "600px 0px" },
      )
    : undefined

  if (!customElements.get("paper-shader-image")) {
    customElements.define("paper-shader-image", PaperShaderImage)
  }

  if (!shaderImageObserver) {
    document.querySelectorAll<PaperShaderImage>("paper-shader-image").forEach((image) => {
      void image.renderShader()
    })
  }
</script>

<style>
  .shader-image {
    margin: 2rem 0;
  }

  paper-shader-image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #fbfaf5;
  }

  .shader-image :global(img),
  .shader-image__mount,
  .shader-image__output {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .shader-image :global(img) {
    object-fit: cover;
  }

  .shader-image__mount,
  .shader-image__output {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .shader-image__mount :global(canvas),
  .shader-image__output {
    display: block;
    width: 100%;
    height: 100%;
  }

  paper-shader-image.is-ready .shader-image__output {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .shader-image__mount,
    .shader-image__output {
      transition: none;
    }
  }
</style>
