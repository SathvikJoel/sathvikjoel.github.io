---
// A single image that opens in the shared fullscreen viewer (zoom, pan, Esc to close)
// when clicked. The caption (slot) shows under the image and again in the viewer.
// Give several ZoomImages the same `group` to browse them as one set.
//   thumb: a smaller file for the in-page image; `src` is the full-size one opened.
//   wide:  break out wider than the text column.
import Lightbox from "../Lightbox.astro"

interface Props {
  src: string
  thumb?: string
  alt?: string
  title?: string
  group?: string
  wide?: boolean
}
const { src, thumb, alt = "", title, group, wide = false } = Astro.props
const hasCaption = Astro.slots.has("default")
---

<figure class:list={["zoom-figure not-prose", wide && "zoom-wide"]}>
  <button
    type="button"
    class="zoom-trigger"
    data-lightbox
    data-src={src}
    data-title={title}
    data-lightbox-group={group}
    aria-label={`Open image full screen${alt ? `: ${alt}` : ""}`}
  >
    <img src={thumb ?? src} alt={alt} loading="lazy" decoding="async" />
    <span class="zoom-lens" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5M11 8.5v5M8.5 11h5" /></svg>
    </span>
  </button>
  {hasCaption && (
    <figcaption class="mt-3 text-center font-sans text-sm leading-snug text-ink-light/60 dark:text-ink-dark/55">
      <slot />
    </figcaption>
  )}
</figure>
<Lightbox />

<style>
  .zoom-figure {
    margin: 2rem 0;
  }
  .zoom-wide {
    width: min(92vw, 1080px);
    margin-left: 50%;
    transform: translateX(-50%);
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .zoom-trigger {
    position: relative;
    display: block;
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: none;
    line-height: 0;
    cursor: zoom-in;
    border-radius: 0.5rem;
    -webkit-tap-highlight-color: transparent;
  }
  .zoom-trigger img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 0.5rem;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }
  .zoom-wide .zoom-trigger,
  .zoom-wide .zoom-trigger img {
    width: 100%;
  }
  .zoom-trigger:hover img {
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.5);
  }
  .zoom-trigger:focus-visible {
    outline: 2px solid #f0c27b;
    outline-offset: 4px;
  }
  .zoom-lens {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(11 11 13 / 0.72);
    color: #fff;
    border: 1.5px solid rgb(255 255 255 / 0.45);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }
  .zoom-lens svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .zoom-trigger:hover .zoom-lens,
  .zoom-trigger:focus-visible .zoom-lens {
    opacity: 1;
    transform: scale(1);
  }
  @media (hover: none) {
    .zoom-lens {
      opacity: 0.85;
      transform: scale(1);
    }
  }
</style>
