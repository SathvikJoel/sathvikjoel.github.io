---
// Embed a tweet / X post. Pass the full status URL. Renders the standard
// embed which Twitter's widget upgrades into a full card; a plain link is the
// no-JS fallback. Works on its own or nested inside a <Card/>.
interface Props {
  url: string
  theme?: "dark" | "light"
}
const { url, theme = "dark" } = Astro.props
---

<div class="tweet-embed not-prose my-8">
  <blockquote class="twitter-tweet" data-theme={theme} data-dnt="true">
    <a href={url}>{url}</a>
  </blockquote>
</div>

<script>
  // Load (or re-process) the X/Twitter widget. Runs once on this full page load and,
  // defensively, on astro:page-load (dormant today since the site has no ClientRouter,
  // but ready if view transitions are ever enabled). Calling twttr.widgets.load()
  // explicitly is what reliably upgrades the blockquote into the rendered card.
  function loadTweets() {
    if (!document.querySelector(".twitter-tweet")) return
    const w = (window as any).twttr
    if (w && w.widgets) {
      w.widgets.load()
      return
    }
    if (!document.getElementById("x-widgets-js")) {
      const s = document.createElement("script")
      s.id = "x-widgets-js"
      s.src = "https://platform.x.com/widgets.js"
      s.async = true
      s.charset = "utf-8"
      document.head.appendChild(s)
    }
  }

  loadTweets()
  document.addEventListener("astro:page-load", loadTweets)
</script>

<style>
  .tweet-embed {
    display: flex;
    justify-content: center;
  }
  .tweet-embed :global(.twitter-tweet) {
    margin-inline: auto;
  }
  /* The X embed iframe paints white triangles in its corners (the cross-origin
     content's default backdrop sits behind its own rounded card). Clip the iframe
     to the same radius so those white corners are removed against the dark page. */
  .tweet-embed :global(.twitter-tweet-rendered iframe) {
    border-radius: 12px;
    overflow: hidden;
  }
</style>
