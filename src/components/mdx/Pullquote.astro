---
// A large, prominent pull-quote for emphasis. Pass `mini` for a smaller, tighter
// variant (e.g. a question or aside) that still keeps the quote styling.
interface Props {
  cite?: string
  mini?: boolean
}
const { cite, mini = false } = Astro.props
---

<figure class:list={["pullquote not-prose", mini && "pullquote-mini"]}>
  <blockquote>
    <slot />
  </blockquote>
  {cite && <figcaption class="pullquote-cite">— {cite}</figcaption>}
</figure>

<style>
  .pullquote {
    @apply my-10 pl-6 border-l-4 border-crimson/40 dark:border-crimson-dark/40;
  }
  .pullquote blockquote {
    @apply font-display text-2xl sm:text-3xl font-light italic leading-snug text-ink-light dark:text-ink-dark m-0;
  }
  .pullquote-mini {
    @apply my-6;
  }
  .pullquote-mini blockquote {
    @apply text-lg sm:text-xl leading-snug;
  }
  .pullquote-cite {
    @apply font-sans not-italic text-sm text-ink-light/55 dark:text-ink-dark/55 mt-4;
  }
  .pullquote-mini .pullquote-cite {
    @apply mt-2;
  }
</style>
