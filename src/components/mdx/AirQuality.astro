---
import AirQuality from "@components/viz/AirQuality"

interface Props {
  caption?: string
  source?: string
}
const base = "/posts/overpopulation/data"
const { caption, source } = Astro.props
---

<figure class="viz-figure not-prose my-10">
  <AirQuality client:visible src={`${base}/air_quality.csv`} />
  {
    (caption || source) && (
      <figcaption class="viz-caption">
        {caption && <span>{caption}</span>}
        {source && <span class="viz-source">{source}</span>}
      </figcaption>
    )
  }
</figure>
