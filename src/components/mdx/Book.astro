---
// A book reference — cover, title, author, and an optional description.
// Inspired by Maggie Appleton's book-card (e.g. /metaphor-books, /now-2024-12).
// With a description it lays out cover + text side by side; use `small` for a
// compact, centred card (good for stacking several into a reading list).
// Covers render at a standard height (width follows each cover's own ratio) so
// any source image stands the same height with no stretching or cropping, and
// the flat cover is turned into a slightly angled 3D book (thickness, page
// leaves, rear cover) that floats just above the dark page. Use ~2:3 covers.
interface Props {
  cover?: string
  coverAlt?: string
  title: string
  author?: string
  href?: string
  small?: boolean
}
const { cover, coverAlt, title, author, href, small = false } = Astro.props
const hasDesc = !!Astro.slots.default && (await Astro.slots.render("default")).trim() !== ""
---

<div class:list={["book-card not-prose", small ? "is-small" : "", hasDesc ? "has-desc" : ""]}>
  <div class:list={["book-cover", !cover && "is-placeholder"]}>
    {
      cover ? (
        <div class="book-3d__inner">
          <span class="book-3d__rear" aria-hidden="true" />
          <span class="book-3d__pages" aria-hidden="true" />
          <img class="book-3d__cover" src={cover} alt={coverAlt ?? title} loading="eager" decoding="async" />
        </div>
      ) : (
        <svg viewBox="0 0 48 64" fill="none" aria-hidden="true">
          <rect x="6" y="4" width="36" height="56" rx="2" stroke="currentColor" stroke-width="2" />
          <line x1="14" y1="4" x2="14" y2="60" stroke="currentColor" stroke-width="1.5" />
          <line x1="20" y1="18" x2="36" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <line x1="20" y1="25" x2="33" y2="25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      )
    }
  </div>
  <div class="book-meta">
    {
      href ? (
        <a href={href} target="_blank" rel="noopener noreferrer" class="book-title-link">
          <h3 class="book-title">{title}</h3>
        </a>
      ) : (
        <h3 class="book-title">{title}</h3>
      )
    }
    {author && <span class="book-author">{author}</span>}
    <span class="book-rule" aria-hidden="true"></span>
    {hasDesc && <div class="book-desc"><slot /></div>}
  </div>
</div>

<style>
  .book-card {
    @apply mx-auto my-8 flex w-full max-w-md items-start gap-10;
  }
  .book-card.is-small {
    @apply my-6 flex-col items-center gap-3 text-center;
  }
  .book-cover {
    @apply flex-shrink-0;
    /* Standard cover SIZE = a fixed height; width follows each cover's own
       proportions. So every book stands the same height in a tidy row (like a
       shelf) with no stretching or cropping, whatever the source image's ratio.
       `perspective` + `--book-thickness` set up the 3D book block inside. */
    height: 348px;
    max-width: 280px;
    perspective: 1100px;
    --book-thickness: 24px;
  }
  .book-card.is-small .book-cover {
    height: 168px;
    --book-thickness: 16px;
  }

  /* A real 3D book built from a flat cover (technique inspired by Heydon/Max
     Böck's CSS bookstore): the cover is pushed forward by the book's thickness,
     a rear cover sits the same distance back, and a band of page leaves bridges
     their right edges. Turned a little so the thickness reads like a hardcover. */
  .book-3d__inner {
    @apply relative inline-block h-full align-top;
    transform-style: preserve-3d;
    transform: rotateY(-25deg);
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .book-card:hover .book-3d__inner {
    transform: rotateY(-16deg);
  }
  .book-3d__cover {
    @apply relative m-0 block h-full;
    /* Render at the cover's own proportions: fixed height, width follows
       naturally. Override the global `article img` rule (20px top/bottom padding)
       and the prose max-width/object-fit that otherwise squeeze the art. */
    width: auto;
    max-width: none;
    padding: 0;
    object-fit: contain;
    border-radius: 1px 4px 4px 1px;
    transform: translateZ(var(--book-thickness));
    /* The page is pure black, so a dark cast shadow is invisible; a soft luminous
       lift below/around makes the book float just above a faintly lit surface. */
    box-shadow:
      0 38px 58px -28px rgba(255, 255, 255, 0.13),
      0 16px 30px -18px rgba(255, 255, 255, 0.08);
  }
  /* Page leaves bridging the front and rear cover on the book's right edge. */
  .book-3d__pages {
    content: "";
    position: absolute;
    left: 100%;
    top: 1%;
    width: calc(var(--book-thickness) * 2);
    height: 98%;
    transform: translateX(-55%) rotateY(90deg);
    background: linear-gradient(
      90deg,
      #f4eede 0%,
      #d8d0b8 4%,
      #f4eede 8%,
      #d8d0b8 12%,
      #f4eede 16%,
      #d8d0b8 20%,
      #f4eede 24%,
      #d8d0b8 28%,
      #f4eede 32%,
      #d8d0b8 36%,
      #f4eede 40%,
      #d8d0b8 44%,
      #f4eede 48%,
      #d8d0b8 52%,
      #f4eede 56%,
      #d8d0b8 60%,
      #f4eede 64%,
      #d8d0b8 68%,
      #f4eede 72%,
      #d8d0b8 76%,
      #f4eede 80%,
      #d8d0b8 84%,
      #f4eede 88%,
      #d8d0b8 92%,
      #f4eede 96%,
      #d8d0b8 100%
    );
  }
  /* Rear cover, set back by the book's thickness behind the front. It is placed
     before the cover img in the DOM on purpose: where a browser flattens the 3D
     scene (common on mobile), paint order wins, so the front cover still draws on
     top instead of being hidden behind this dark panel — the book just falls back
     to a flat cover rather than disappearing. */
  .book-3d__rear {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: translateZ(calc(var(--book-thickness) * -1));
    background-color: #25221e;
    border-radius: 0 4px 4px 0;
    box-shadow: -10px 0 50px 10px rgba(0, 0, 0, 0.3);
  }
  .book-cover.is-placeholder {
    @apply flex items-center justify-center rounded-md border border-clay/25 bg-clay/5 text-clay/45 shadow-none dark:border-white/15 dark:bg-white/[0.03] dark:text-white/30;
    /* No image to set the width, so give the empty card a standard 2:3 footprint. */
    width: 232px;
  }
  .book-card.is-small .book-cover.is-placeholder {
    width: 112px;
  }
  .book-cover.is-placeholder :global(svg) {
    width: 50%;
    height: auto;
  }
  .book-meta {
    @apply flex flex-col items-start gap-2;
  }
  .book-card.is-small .book-meta {
    @apply items-center;
  }
  .book-title-link {
    @apply no-underline transition-colors;
  }
  .book-title {
    @apply m-0 font-display text-[1.7rem] font-light text-ink-light transition-colors dark:text-[#EAE8E5];
    line-height: 1.12;
    letter-spacing: -0.015em;
    /* Trim the display font's top side-bearing so the title's cap-height lines up
       with the very top edge of the cover (the Maggie Appleton book-card look). */
    margin-top: -0.08em;
  }
  .book-title-link:hover .book-title {
    @apply text-crimson dark:text-crimson-dark;
  }
  .book-author {
    @apply font-serif text-base text-ink-light/65 dark:text-ink-dark/60;
  }
  .book-rule {
    @apply my-1 block h-px w-10 bg-clay/40 dark:bg-white/25;
  }
  .book-desc {
    @apply font-sans text-sm leading-relaxed text-ink-light/80 dark:text-ink-dark/75;
  }
  .book-desc :global(p) {
    @apply m-0;
  }

  /* On phones, stack the book on top with the title, author and blurb below it,
     all centred in the column. The 3D book (perspective + preserve-3d) is dropped
     here: mobile browsers often fail to load/size an <img> inside a transformed
     3D context, leaving only the page-edge visible. So phones get a plain, flat,
     reliably-rendered cover, centred, with a flat faux page-edge on the right. */
  @media (max-width: 600px) {
    .book-card:not(.is-small) {
      @apply flex-col items-center gap-6 text-center;
    }
    .book-card:not(.is-small) .book-cover {
      height: 300px;
      perspective: none;
    }
    .book-3d__inner {
      transform: none;
      transform-style: flat;
    }
    .book-3d__cover {
      transform: none;
    }
    .book-3d__rear {
      display: none;
    }
    /* Flat page-edge: a thin strip of stacked-paper lines on the cover's right. */
    .book-3d__pages {
      left: auto;
      right: -8px;
      top: 1.5%;
      height: 97%;
      width: 8px;
      transform: skewY(-1.5deg);
      transform-origin: left center;
      border-radius: 0 2px 2px 0;
      background: repeating-linear-gradient(
        to bottom,
        #f4eede 0,
        #f4eede 1.5px,
        #cdc4a9 3px,
        #f4eede 4.5px
      );
      box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.15);
    }
    .book-card:not(.is-small) .book-cover.is-placeholder {
      width: 200px;
    }
    .book-card:not(.is-small) .book-meta {
      @apply items-center;
    }
    .book-title {
      @apply text-2xl;
    }
  }
  @media (max-width: 400px) {
    .book-card:not(.is-small) .book-cover {
      height: 270px;
    }
    .book-card:not(.is-small) .book-cover.is-placeholder {
      width: 180px;
    }
  }
</style>
