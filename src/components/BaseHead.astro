---
import { SITE, SOCIALS } from "@consts"

interface Props {
  title: string
  description: string
  image?: string
  imageAlt?: string
  // SEO: when true, emit <meta name="robots" content="noindex"> (draft/unlisted pages).
  noindex?: boolean
  // OpenGraph object type — "article" for posts, "website" for everything else.
  type?: "website" | "article"
  // ISO timestamps + tags, used for article meta + BlogPosting structured data.
  publishedTime?: string
  modifiedTime?: string
  keywords?: string[]
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const {
  title,
  description,
  image = "/open-graph.jpg",
  imageAlt = "JoeLogs — the digital garden of Sathvik Joel",
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  keywords = [],
} = Astro.props

const siteURL = Astro.site?.href ?? "https://sathvikjoel.github.io/"
const ogImageURL = new URL(image, Astro.url).href
// BaseHead receives the full "<page> | JoeLogs" title; strip the suffix for the headline.
const headline = title.replace(new RegExp(` \\| ${SITE.TITLE}$`), "")

// JSON-LD: a site-wide WebSite + Person graph, plus a BlogPosting on article pages.
const person = {
  "@type": "Person",
  "@id": `${siteURL}#person`,
  name: SITE.AUTHOR,
  url: siteURL,
  sameAs: SOCIALS.map((s) => s.HREF),
}
const website = {
  "@type": "WebSite",
  "@id": `${siteURL}#website`,
  url: siteURL,
  name: SITE.TITLE,
  description: SITE.DESCRIPTION,
  publisher: { "@id": `${siteURL}#person` },
}
const graph: Record<string, unknown>[] = [website, person]
if (type === "article") {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonicalURL.href}#article`,
    headline,
    description,
    url: canonicalURL.href,
    mainEntityOfPage: canonicalURL.href,
    image: ogImageURL,
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    dateModified: modifiedTime ?? publishedTime,
    author: { "@id": `${siteURL}#person` },
    publisher: { "@id": `${siteURL}#person` },
    ...(keywords.length ? { keywords: keywords.join(", ") } : {}),
  })
}
const jsonLd = { "@context": "https://schema.org", "@graph": graph }
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Google Search Console site verification -->
<meta name="google-site-verification" content="OaovjcYYk5byM2Yj7tEUIlq0rH5TfXTu6CBxmX8PQ3c" />

<!-- Robots -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="JoeLogs" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Article metadata -->
{type === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === "article" && (modifiedTime || publishedTime) && (
  <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
)}
{type === "article" && <meta property="article:author" content={SITE.AUTHOR} />}
{type === "article" &&
  keywords.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:site" content="@JoelSathvik" />
<meta property="twitter:creator" content="@JoelSathvik" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta property="twitter:image:alt" content={imageAlt} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title={title} href={`${Astro.site}rss.xml`}/>

<!-- Structured data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Global Scripts -->
<script is:inline>
  // Arm the homepage card reveal before first paint so cards never flash
  // visible-then-hidden. Only when JS is on and motion is allowed.
  try {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("reveal-js")
    }
  } catch (e) {}
</script>
<script is:inline src="/js/animate.js"></script>
<script defer is:inline src="/js/copy.js"></script>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client"
  document.addEventListener("astro:before-swap", (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
        "link[as=\"font\"]"
      ),
    ].forEach((link) => link.remove())
  )
</script>
