---
// Custom hand-drawn growth-stage icons (no emoji, no icon library).
// Sprout → budding plant → leafy tree. Each sways gently when its card is hovered.
// `now` is a special non-growth state used by "Now" snapshots — a blue clock.
type Props = {
  stage: "seedling" | "budding" | "evergreen" | "now" | string
  class?: string
}
const { stage, class: className = "" } = Astro.props

const tint: Record<string, string> = {
  seedling: "text-sage dark:text-sage-dark",
  budding: "text-gold",
  evergreen: "text-clay dark:text-clay-dark",
  now: "text-sage dark:text-sage-dark",
}
const label: Record<string, string> = {
  seedling: "Seedling",
  budding: "Budding",
  evergreen: "Evergreen",
  now: "Now",
}
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={`${label[stage] ?? stage} stage`}
  class:list={["stage-icon origin-bottom group-hover:animate-sway", tint[stage] ?? "text-current", className]}
>
  {stage === "seedling" && (
    <>
      <path d="M4 19q8 -2 16 0" stroke-opacity="0.5" />
      <path d="M12 19V11" />
      <path d="M12 11C8.5 11 6.5 8.5 7.6 6.4 10.2 7.2 12 9 12 11Z" fill="currentColor" fill-opacity="0.12" />
      <path d="M12 11C15.5 11 17.5 8.5 16.4 6.4 13.8 7.2 12 9 12 11Z" fill="currentColor" fill-opacity="0.12" />
    </>
  )}
  {stage === "budding" && (
    <>
      <path d="M5 20q7 -1.5 14 0" stroke-opacity="0.5" />
      <path d="M12 20V7" />
      <path d="M12 14C8 14 6.4 11.4 7.8 9.8 10.4 10.8 12 12.4 12 14Z" fill="currentColor" fill-opacity="0.12" />
      <path d="M12 12C16 12 17.6 9.4 16.2 7.8 13.6 8.8 12 10.4 12 12Z" fill="currentColor" fill-opacity="0.12" />
      <path d="M12 7C10.5 5.5 11 3.2 12 2.4 13 3.2 13.5 5.5 12 7Z" fill="currentColor" fill-opacity="0.18" />
    </>
  )}
  {stage === "evergreen" && (
    <>
      <path d="M12 21V14" />
      <path d="M12 3.5C7.4 3.5 5.4 7.3 6.7 10.2 4.9 12.2 6.4 15.4 9.2 14.9 10.2 16.6 13.8 16.6 14.8 14.9 17.6 15.4 19.1 12.2 17.3 10.2 18.6 7.3 16.6 3.5 12 3.5Z" fill="currentColor" fill-opacity="0.12" />
      <path d="M12 8V14" stroke-opacity="0.5" />
      <path d="M9.5 10.5 12 12l2.5-1.5" stroke-opacity="0.5" />
    </>
  )}
  {stage === "now" && (
    <>
      <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.1" />
      <path d="M12 7.5v4.8l3.4 2" />
    </>
  )}
</svg>

<style>
  .stage-icon {
    transform-box: fill-box;
    transform-origin: bottom center;
  }
</style>
